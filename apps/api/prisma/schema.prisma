// Fonte única da modelagem. Toda alteração aqui vira uma migration SQL
// versionada em prisma/migrations — o banco nunca é alterado à mão.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Conta de acesso à plataforma. A identidade é global: a mesma conta participa
/// de várias ligas. O vínculo com a liga (e o saldo) mora em outra tabela, não aqui.
model User {
  // UUID v7 gerado pela aplicação. v7 carrega o instante de criação no prefixo,
  // então as chaves entram quase em ordem e o índice primário não fragmenta como
  // com v4 aleatório. Preço: INSERT feito direto no psql precisa informar o id,
  // porque o default vive no client e não na coluna.
  id String @id @default(uuid(7)) @db.Uuid

  name String @db.VarChar(120)

  // Guardado sempre normalizado (trim + lowercase) pela aplicação: o UNIQUE do
  // Postgres compara byte a byte, e sem isso "ana@mail.com" e "Ana@Mail.com"
  // virariam duas contas.
  email String @unique @db.VarChar(255)

  // Hash da senha, nunca a senha. O nome da coluna é parte da defesa: gravar
  // texto puro aqui fica obviamente errado na leitura. Sem limite de tamanho
  // porque a lib de hash ainda não foi escolhida e cada uma produz um tamanho
  // diferente (bcrypt 60, argon2 ~100).
  passwordHash String @map("password_hash")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Lado inverso da participação. Não vira coluna: existe só para o Prisma
  // saber navegar da conta para as ligas dela.
  leagues LeagueParticipant[]

  // Convites recebidos. Lado inverso também: quem é convidado para quê mora
  // em `LeagueInvite`.
  invites LeagueInvite[]

  @@map("users")
}

/// Competição entre amigos, com janela de tempo própria. A liga é a entidade
/// compartilhada: quem participa dela mora em `LeagueParticipant`, nunca aqui —
/// uma coluna de participante na própria liga quebraria o compartilhamento
/// (cada linha viraria uma pessoa solta, sem nada que as agrupasse).
///
/// Não existe coluna de dono nem de papel: numa liga entre amigos não há
/// permissão a conceder, então quem cria entra como participante comum. A
/// consequência é assumida — "quem criou" não é recuperável depois. Se um dia
/// aparecer encerrar liga ou remover participante, o papel nasce ali, com
/// migration própria, e não especulado agora.
model League {
  // Mesmo padrão de chave do `User`: UUID v7 gerado pela aplicação.
  id String @id @default(uuid(7)) @db.Uuid

  // Nome que o grupo dá à competição. Sem UNIQUE de propósito: dois grupos de
  // amigos podem ter a sua "Liga dos Amigos", e a identidade da liga é o id —
  // o nome é rótulo, não chave.
  name String @db.VarChar(60)

  // Janela de disputa. `Timestamptz` e não `Date`: a liga começa e termina em
  // um instante, e o ranking precisa saber se a ordem caiu dentro dela — com
  // participantes em fusos diferentes, data sem hora é ambígua.
  startsAt DateTime @map("starts_at") @db.Timestamptz(6)
  endsAt   DateTime @map("ends_at") @db.Timestamptz(6)

  /// Saldo fictício com que **todo** participante desta liga começa, em dólar.
  ///
  /// Mora na liga, e não no participante, porque "todos recebem o mesmo saldo"
  /// é propriedade da competição: com a coluna aqui, é o schema que garante a
  /// igualdade — quem entra no meio da liga recebe o mesmo valor de quem criou,
  /// mesmo que o padrão do ambiente tenha mudado no intervalo.
  ///
  /// É uma cópia do valor configurado em `LEAGUE_INITIAL_BALANCE`, congelada no
  /// instante da criação, e não uma leitura do ambiente a cada consulta: o
  /// ranking calcula retorno sobre esta base, e uma base que muda reescreveria o
  /// desempenho de ligas já encerradas.
  ///
  /// `Decimal` e nunca `Float`: dinheiro em ponto flutuante perde centavo na
  /// soma. A escala 8 acompanha a precisão de quantidade de cripto — o débito de
  /// uma ordem é quantidade × preço, e com escala 2 o Postgres arredondaria essa
  /// conta em silêncio, antes de existir uma regra de arredondamento decidida.
  initialBalance Decimal @map("initial_balance") @db.Decimal(20, 8)

  participants LeagueParticipant[]
  invites      LeagueInvite[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("leagues")
}

/// Vínculo entre uma conta e uma liga — é esta tabela que realiza o N:N
/// ("um usuário em várias ligas, uma liga com vários usuários").
///
/// O nome do participante não é copiado para cá: ele vem de `users.name` por
/// join. Copiar criaria duas verdades para o mesmo dado, e a cópia envelheceria
/// no dia em que a pessoa trocasse o nome.
model LeagueParticipant {
  id String @id @default(uuid(7)) @db.Uuid

  leagueId String @map("league_id") @db.Uuid
  // Apagar a liga apaga as participações dela: participação sem liga é lixo,
  // não tem leitura possível.
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid
  // Já a conta é restrita: apagar quem tem histórico de disputa deixaria o
  // ranking com um buraco. Se um dia existir exclusão de conta, ela precisa
  // decidir explicitamente o que fazer com as ligas.
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  /// Dinheiro fictício que esta pessoa ainda tem **nesta** liga, em dólar.
  ///
  /// É aqui que a carteira por liga acontece: a mesma conta em três ligas tem
  /// três linhas, cada uma com o próprio saldo. Uma coluna em `users` daria
  /// carteira única e as ligas passariam a interferir uma na outra.
  ///
  /// Nasce igual a `leagues.initial_balance` e muda a cada ordem; a base de
  /// comparação do ranking continua na liga. São dois dados diferentes —
  /// "com quanto começou" e "quanto tem agora" —, e por isso duas colunas:
  /// guardar só este perderia a base no dia em que o padrão do ambiente mudasse.
  ///
  /// Sem `@default`: o valor vem sempre da liga, decidido pela aplicação. Um
  /// default no banco deixaria um INSERT que esqueceu o saldo passar calado,
  /// com participante começando com zero.
  cashBalance Decimal @map("cash_balance") @db.Decimal(20, 8)

  // Entrar duas vezes na mesma liga duplicaria a pessoa no ranking. Quem impede
  // é o índice único do banco, não uma verificação antes do INSERT: dois
  // pedidos simultâneos passariam pela verificação e os dois gravariam.
  @@unique([leagueId, userId])

  // O único cobre `league_id` (é o prefixo dele), mas não `user_id` sozinho —
  // e "as ligas deste usuário" filtra exatamente por `user_id`.
  @@index([userId])
  @@map("league_participants")
}

/// Convite pendente para entrar numa liga.
///
/// É tabela separada de `league_participants` de propósito, e não uma coluna
/// de situação lá: assim "participante" continua significando "está dentro da
/// liga", verdade única. Nenhuma consulta de participação — a autorização por
/// liga, a lista de candidatos e, depois, ordens e ranking — precisa aprender
/// a filtrar convidado-que-ainda-não-aceitou. Esquecer esse filtro em uma
/// consulta só seria vazamento silencioso, não erro de compilação.
///
/// A linha existe **enquanto o convite está pendente**: aceitar cria a
/// participação e apaga o convite (na mesma transação), recusar apaga. Não há
/// histórico de aceite nem de recusa, por decisão registrada — guardá-lo
/// exigiria coluna de situação e uma regra para "convite recusado pode ser
/// reenviado?", que o MVP não precisa responder.
model LeagueInvite {
  id String @id @default(uuid(7)) @db.Uuid

  leagueId String @map("league_id") @db.Uuid
  // Apagar a liga apaga os convites dela: convite para liga que não existe não
  // tem leitura possível.
  league   League @relation(fields: [leagueId], references: [id], onDelete: Cascade)

  invitedUserId String @map("invited_user_id") @db.Uuid
  // Mesma restrição da participação: apagar conta com convite pendente exigiria
  // decidir o que fazer com ele, e hoje não há exclusão de conta.
  invitedUser   User   @relation(fields: [invitedUserId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // Convidar duas vezes a mesma pessoa para a mesma liga empilharia convites
  // idênticos na tela dela. Quem impede é o índice único do banco, não uma
  // verificação antes do INSERT: dois cliques simultâneos passariam pela
  // verificação e os dois gravariam.
  @@unique([leagueId, invitedUserId])

  // "Meus convites" filtra exatamente por `invited_user_id`, que não é prefixo
  // do único acima.
  @@index([invitedUserId])
  @@map("league_invites")
}
