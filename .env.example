# Copie para .env antes de subir o ambiente:  cp .env.example .env
# O docker-compose.yml exige o arquivo .env e falha se ele não existir.

# Porta do host em que a API é publicada. Dentro do container ela é sempre 3000.
# 3000 é o padrão do Nest, mas costuma estar ocupada por outros projetos.
# Ao mudar aqui, ajuste VITE_API_URL abaixo.
API_PORT=3100

# Origem do front autorizada no CORS da API.
# Precisa bater com a porta publicada do serviço `web` no docker-compose.yml.
WEB_ORIGIN=http://localhost:5173

# URL da API usada pelo front, lida no navegador.
# O prefixo VITE_ é obrigatório: o Vite só expõe ao bundle as variáveis com ele.
# É localhost (e não http://api:3000) porque quem faz a requisição é o browser
# do host, que não enxerga a rede interna do compose.
VITE_API_URL=http://localhost:3100

# Segredo que assina o token de login (JWT). Sem ele a API não sobe.
# Em produção use um valor longo e aleatório, nunca este. Para gerar um:
#   docker compose exec api node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar o segredo invalida todos os tokens já emitidos — todo mundo reloga.
JWT_SECRET=segredo_de_desenvolvimento_trocar_em_producao

# Saldo fictício, em dólar, com que cada participante começa uma liga.
# Aceita até 8 casas decimais, com ponto (não vírgula), e tem de ser maior que
# zero.
LEAGUE_INITIAL_BALANCE=10000

# Credenciais do Postgres de desenvolvimento.
POSTGRES_USER=vault
POSTGRES_PASSWORD=vault_dev
POSTGRES_DB=vault_capital

# Porta do host em que o banco é publicada. 5432 é a padrão do Postgres, então usar outra.
POSTGRES_PORT=5433